# Live demo variables (developer-tasks doc §12.4). Paste into Railway -> web service ->
# Variables -> Raw Editor, replace every <...>, and mark passwords/tokens as sealed.
DEMO_ENABLED=true
DEMO_SOURCE=live
DEMO_STATION_ID=YVN-DEMO-01
DEMO_STATION_NAME=DigiTech Substation
DEMO_LAT=40.1777
DEMO_LNG=44.5126
TZ=Asia/Yerevan
DATABASE_URL=${{Postgres.DATABASE_URL}}
MQTT_URL=mqtts://<cluster-host>:8883
MQTT_USERNAME=<app-user>
MQTT_PASSWORD=<app-password>
MQTT_CLIENT_ID=e2b-railway-ingestor
MQTT_TOPIC=<topic-from-HW-5>
PAYLOAD_FORMAT=fourfaith
FIELD_VOLTAGE=voltage
FIELD_CURRENT=current
FIELD_POWER=power
FIELD_PF=pf
FIELD_FREQ=freq
FIELD_ENERGY=energy
POWER_WARN_W=600
POWER_ALARM_W=1000
POWER_MIN_ALARM_W=50
ALARM_HOLD_SECONDS=2
ALARM_CLEAR_W=400
ALARM_CLEAR_SECONDS=5
BASELINE_WINDOW_SECONDS=60
BASELINE_MULTIPLIER=3
STALE_AFTER_SECONDS=15
LATE_AFTER_SECONDS=10
READINGS_RETENTION_DAYS=7
SMS_ENABLED=true
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=<secret>
TWILIO_AUTH_TOKEN=<secret>
TWILIO_MESSAGING_SERVICE_SID=<MG...>
SMSGATE_URL=<android-gateway-url>
SMSGATE_USERNAME=<user>
SMSGATE_PASSWORD=<password>
SMS_TEMPLATE=GridBox ALERT: Sudden power spike at {station}: {powerW} W (usual {usualW} W, limit {alarmW} W). {time}
SMS_WELCOME_TEMPLATE=Welcome to the GridBox live demo. Stop: {unsubUrl}
SMS_ON_RECOVERY=true
SMS_ALWAYS_NOTIFY=+374XXXXXXXX
SMS_COOLDOWN_SECONDS=60
SMS_MAX_PER_NUMBER=5
SMS_MAX_PER_HOUR=200
SUBSCRIBER_TTL_HOURS=24
PUBLIC_BASE_URL=https://<app>.up.railway.app
ADMIN_TOKEN=<long-random-string>

# --- optional extras (not in the doc table) ---
# SMS_STYLE=tailored        tailored = texts built from the measured numbers with a fix (live/advice.py);
#                           template = SMS_TEMPLATE / SMS_RECOVERY_TEMPLATE as written
# SMS_LANG=per_user         per_user = language picked on the join page; or both / en / hy for everyone
# SMS_TEAM_LANG=both        language for SMS_ALWAYS_NOTIFY numbers (with SMS_LANG=per_user)
# SMS_PREVIEW=auto          show each SMS text as a pop-up on /live and /demo/sim; auto = only while
#                           SMS_PROVIDER=console, so it disappears once a real provider is set
# CIRCUIT_RATED_A=16        socket / breaker rating used in the advice ("58% of the 16 A socket")
# TARIFF_PER_KWH=0          e.g. 48 to add the cost in the SMS; TARIFF_CURRENCY=AMD
# LIVE_PUBLIC=true          /live and /api/live/* skip DASHBOARD_PASSWORD (join/unsubscribe/admin always do)
# DEVICE_TIME=true          false = ignore the gateway's timestamp (use if its clock is wrong)
# FIELD_TS=ts               key of the gateway timestamp
# TWILIO_FROM=+1...         number sender instead of a Messaging Service
# SMS_RECOVERY_TEMPLATE=GridBox: {station} back to normal ({powerW} W). {time}
# SIM_LIGHT_W=9             simulator: power of the LED light
# LIVE_DB=/data/live.db     SQLite file used when DATABASE_URL is empty

# --- on/off (DI) mode: real gateway via tools/di_bridge.py (Real Gateway DI tasks doc) ---
# LIVE_SIGNAL=di            power (default, energy meter) | di (on/off from the gateway's digital input)
# FIELD_DI=di1              name of the on/off value in the bridge's message
# DI_OFF_HOLD_SECONDS=3     a 0 must last this long before it is an outage (filters switch bounce)
# DI_ON_HOLD_SECONDS=2      a 1 must last this long before "restored"
# STATUS_TOPIC=e2b/demo/yvn-01/status   bridge online/offline (MQTT last will); not a reading
# MQTT_TOPIC=e2b/demo/yvn-01/#          must cover the DI topic and the status topic
# SMS_ON_NO_DATA=false      true = also SMS when the gateway is silent for NO_DATA_SMS_AFTER_SECONDS
# NO_DATA_SMS_AFTER_SECONDS=120
# SMS_DI_OFF_TEMPLATE= / SMS_DI_ON_TEMPLATE= / SMS_DI_NO_DATA_TEMPLATE=
#                           own texts with {station} {time} {duration}; empty = built-in English + Armenian

# --- alerts by email instead of SMS (Resend) ---
# ALERT_CHANNEL=sms          sms (phone sign-ups, SMS_PROVIDER) | email (email sign-ups, Resend API)
# RESEND_API_KEY=re_...      from resend.com -> API Keys (sending access); mark it sealed
# EMAIL_FROM=GridBox Alerts <alerts@your-verified-domain>
#                            onboarding@resend.dev works without a domain but only delivers to your own Resend address
# EMAIL_REPLY_TO=            optional
# EMAIL_RECIPIENTS=latest    latest = alerts go only to the most recent sign-up (every address is kept in the
#                            database, none deleted after 24 h) | all = every sign-up from the last 24 h
# EMAIL_ALWAYS_NOTIFY=a@x.am,b@y.am   team addresses (no daily cap), like SMS_ALWAYS_NOTIFY
# SMS_ENABLED, SMS_LANG, SMS_COOLDOWN_SECONDS, SMS_MAX_PER_NUMBER, SMS_MAX_PER_HOUR, SMS_ON_RECOVERY,
# SUBSCRIBER_TTL_HOURS and SMS_PREVIEW apply to emails too (one set of rules for both channels).
