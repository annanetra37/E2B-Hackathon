# Live demo variables (developer-tasks doc §12.4). Paste into Railway -> web service ->
# Variables -> Raw Editor, replace every <...>, and mark passwords/tokens as sealed.
DEMO_ENABLED=true
DEMO_SOURCE=live
DEMO_STATION_ID=YVN-DEMO-01
DEMO_STATION_NAME=DigiTech Substation
DEMO_LAT=40.1777
DEMO_LNG=44.5126
TZ=Asia/Yerevan
DATABASE_URL=${{Postgres.DATABASE_URL}}
MQTT_URL=mqtts://<cluster-host>:8883
MQTT_USERNAME=<app-user>
MQTT_PASSWORD=<app-password>
MQTT_CLIENT_ID=e2b-railway-ingestor
MQTT_TOPIC=<topic-from-HW-5>
PAYLOAD_FORMAT=fourfaith
FIELD_VOLTAGE=voltage
FIELD_CURRENT=current
FIELD_POWER=power
FIELD_PF=pf
FIELD_FREQ=freq
FIELD_ENERGY=energy
POWER_WARN_W=600
POWER_ALARM_W=1000
POWER_MIN_ALARM_W=50
ALARM_HOLD_SECONDS=2
ALARM_CLEAR_W=400
ALARM_CLEAR_SECONDS=5
BASELINE_WINDOW_SECONDS=60
BASELINE_MULTIPLIER=3
STALE_AFTER_SECONDS=15
LATE_AFTER_SECONDS=10
READINGS_RETENTION_DAYS=7
SMS_ENABLED=true
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=<secret>
TWILIO_AUTH_TOKEN=<secret>
TWILIO_MESSAGING_SERVICE_SID=<MG...>
SMSGATE_URL=<android-gateway-url>
SMSGATE_USERNAME=<user>
SMSGATE_PASSWORD=<password>
SMS_TEMPLATE=E2B ALERT: Sudden power spike at {station}: {powerW} W (usual {usualW} W, limit {alarmW} W). {time}
SMS_WELCOME_TEMPLATE=Welcome to the E2b live demo. Stop: {unsubUrl}
SMS_ON_RECOVERY=true
SMS_ALWAYS_NOTIFY=+374XXXXXXXX
SMS_COOLDOWN_SECONDS=60
SMS_MAX_PER_NUMBER=5
SMS_MAX_PER_HOUR=200
SUBSCRIBER_TTL_HOURS=24
PUBLIC_BASE_URL=https://<app>.up.railway.app
ADMIN_TOKEN=<long-random-string>

# --- optional extras (not in the doc table) ---
# SMS_STYLE=tailored        tailored = texts built from the measured numbers with a fix (live/advice.py);
#                           template = SMS_TEMPLATE / SMS_RECOVERY_TEMPLATE as written
# CIRCUIT_RATED_A=16        socket / breaker rating used in the advice ("58% of the 16 A socket")
# TARIFF_PER_KWH=0          e.g. 48 to add the cost in the SMS; TARIFF_CURRENCY=AMD
# LIVE_PUBLIC=true          /live and /api/live/* skip DASHBOARD_PASSWORD (join/unsubscribe/admin always do)
# DEVICE_TIME=true          false = ignore the gateway's timestamp (use if its clock is wrong)
# FIELD_TS=ts               key of the gateway timestamp
# TWILIO_FROM=+1...         number sender instead of a Messaging Service
# SMS_RECOVERY_TEMPLATE=E2B: {station} back to normal ({powerW} W). {time}
# SIM_LIGHT_W=9             simulator: power of the LED light
# LIVE_DB=/data/live.db     SQLite file used when DATABASE_URL is empty
