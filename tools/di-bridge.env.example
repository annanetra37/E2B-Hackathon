# DI bridge settings (copy to tools/.env or /etc/e2b/di-bridge.env; never commit the real file).
ROUTER_URL=https://10.18.249.233
ROUTER_USER=admin
ROUTER_PASSWORD=<router password>
MQTT_URL=mqtts://<emqx-host>:8883
MQTT_USERNAME=di-bridge
MQTT_PASSWORD=<di-bridge password>
MQTT_CLIENT_ID=e2b-di-bridge-01
MQTT_TOPIC=e2b/demo/yvn-01/di
STATUS_TOPIC=e2b/demo/yvn-01/status
STATION_ID=YVN-DEMO-01
POLL_SECONDS=1
HEARTBEAT_SECONDS=2
DI_LOW_MEANS_ON=true

# --- router API format: the defaults match the IWR405 web page (docs/payload-samples/router-rpc.md) ---
# --- only uncomment these for a different firmware ---
# Placeholders: {user} {password} {token} {method} {id}
# ROUTER_RPC_PATH=/v1/rpc
# ROUTER_DI_METHOD=do_di_status_get
# ROUTER_DI_BODY={"jsonrpc": "2.0", "id": {id}, "method": "{method}"}
# ROUTER_LOGIN_PATH=/v1/rpc
# ROUTER_LOGIN_BODY={"jsonrpc": "2.0", "id": {id}, "method": "login", "params": {"username": "{user}", "password": "{password}"}}
#   empty ROUTER_LOGIN_BODY = no login call (e.g. the DI call works without a session)
# ROUTER_HEADERS={"Authorization": "{token}", "Cookie": "Admin-Token={token}"}
# ROUTER_DI_KEY=di_status   name of the DI value in the reply (empty = found automatically)
# ROUTER_DI_ONE_IS=LOW      IWR405: di_status 1 = "low level"; set HIGH if your router reports the opposite
# ROUTER_TIMEOUT=0.8
